{
  "name": "familytrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:ios": "node scripts/test-ios-companion.mjs",
    "test:notifications": "node scripts/test-native-push.mjs && node --experimental-test-module-mocks --test backend/test/*.test.js",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/create-static-seo-pages.mjs",
    "build:ios": "vite build --mode ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@supabase/supabase-js": "^2.101.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^5.0.0"
  }
}
